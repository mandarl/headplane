# Example environment file for the benchmark harness.
#
# Copy to bench/headplane.env (git-ignored) and adjust. The cookie secret
# must be exactly 32 characters. The Headscale URL is intentionally
# unreachable: the harness measures the Headplane server itself, and the
# /healthz endpoint honestly reports ERROR when Headscale is down while
# still proving the server pipeline is up.
#
# Usage:
#   cp bench/headplane.env.example bench/headplane.env
#   HP_IMAGE=headplane:node HP_ENV_FILE=bench/headplane.env ./bench/measure.sh

HEADPLANE_SERVER__HOST=0.0.0.0
HEADPLANE_SERVER__PORT=3000
HEADPLANE_SERVER__COOKIE_SECRET=0123456789abcdef0123456789abcdef
HEADPLANE_SERVER__DATA_PATH=/tmp/headplane-bench
HEADPLANE_HEADSCALE__URL=http://127.0.0.1:1
